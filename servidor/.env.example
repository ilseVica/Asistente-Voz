# Copiar a .env y rellenar. El .env real NUNCA entra al repositorio.
# El archivo se queda en 600 y Compose lo carga solo por estar en servidor/.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Las contrasenas se crean con servidor/mosquitto/crear-usuarios.sh, que
# escribe los hashes en el passwd del directorio de secretos. Aqui van las
# contrasenas en claro, solo para poder usarlas al conectar.

# Fecha del despliegue, para saber cuando hay que rotar.
MQTT_FECHA_INSTALACION=2026-10-03

# Directorio del host donde vive el archivo passwd. Fuera del repositorio:
# esta fuera de /home/ilse/Servidores/Asistente-Voz a proposito, para que un
# "git add ." jamas lo pueda capturar.
MOSQUITTO_SECRETS_DIR=/home/ilse/Servidores/asistente-voz-secretos/mosquitto

# Contrasena del usuario "salud", que solo usa el healthcheck.
MQTT_SALUD_PASSWORD=cambiar-salud

# Contrasenas de los cinco usuarios reales del plan.
MQTT_NODO_PASSWORD=cambiar-nodo
MQTT_PUENTE_PASSWORD=cambiar-puente
MQTT_ORQUESTADOR_PASSWORD=cambiar-orquestador
MQTT_SATELITE_PASSWORD=cambiar-satelite

# Nota de gitignore: .env esta ignorado en la raiz del repositorio.
